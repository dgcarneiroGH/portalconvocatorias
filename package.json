{
  "name": "portalconvocatorias",
  "version": "1.0.0",
  "description": "Portal de Convocatorias - Recopilatorio de ayudas y ayudas en Espana",
  "private": true,
  "scripts": {
    "build": "hugo --minify --baseURL https://portalconvocatorias.es/",
    "dev": "hugo server -D",
    "verify": "node scripts/verify-seo.js",
    "test": "npm run build && node scripts/verify-category-rendering.js",
    "validate-schema": "node scripts/validate-schema.js",
    "validate-sectores": "node scripts/validate-sectores.js",
    "audit-aeo": "node scripts/audit-aeo.js",
    "check": "npm run build && npm run verify && npm run validate-schema && npm run validate-sectores",
    "og:build": "node scripts/embed-logo.js && node scripts/og-render.js",
    "logo:convert": "node scripts/convert-logo.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "hugo",
    "seo",
    "ayudas",
    "convocatorias"
  ],
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.62.0",
    "sharp": "^0.35.3"
  }
}